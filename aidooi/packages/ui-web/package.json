{
  "name": "@aidooi/ui-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./vite": "./vite.config.base.ts",
    "./tsconfig.app.json": "./tsconfig.app.json",
    "./test-setup": "./vitest.setup.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "dev:playground": "vite --config playground/vite.config.ts",
